{
  "name": "@toxicwind/tau-extensions",
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tau/tau-agent": "workspace:*",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "biome check packages/*/src",
    "test": "bun test packages/*",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules .tsbuildinfo packages/*/.tsbuildinfo"
  }
}